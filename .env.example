# Provider credentials (server-only)
GEMINI_API_KEY=
NIMBLE_API_KEY=
SENSO_API_KEY=
SENSO_HANDLE=

# Product persistence. Required for durable jobs and any external publication.
DATABASE_URL=
PUBLIC_WIRE_ARTIFACT_DIR=.data/public-wire-artifacts
PUBLIC_WIRE_REQUEST_SCOPE_SECRET=
PUBLIC_WIRE_INTERNAL_COMMAND_TOKEN=
PUBLIC_WIRE_INTERNAL_ACTOR=public-wire-editor
PUBLIC_WIRE_INTERNAL_ACTOR_ROLE=editor

# ADK uses the Gemini Developer API directly. Vertex AI is never inferred.
PUBLIC_WIRE_AI_MODE=shadow
PUBLIC_WIRE_ADK_MODEL=gemini-2.5-flash
PUBLIC_WIRE_ADK_MAX_EVIDENCE_ITERATIONS=2
PUBLIC_WIRE_ADK_MAX_DRAFT_REVISIONS=1
PUBLIC_WIRE_ADK_MAX_MODEL_CALLS=12
PUBLIC_WIRE_ADK_MAX_TOOL_CALLS=24
PUBLIC_WIRE_ADK_TIMEOUT_MS=45000
PUBLIC_WIRE_PROMPT_VERSION=2026-07-20.1
PUBLIC_WIRE_SCHEMA_VERSION=1
PUBLIC_WIRE_POLICY_VERSION=2026-07-19.1

# Both switches must permit publication. Defaults are fail-closed.
PUBLIC_WIRE_PUBLICATION_ENABLED=false
PUBLIC_WIRE_EMERGENCY_PUBLISH_KILL_SWITCH=true
PUBLIC_WIRE_ADK_SHADOW_PUBLISH=false

# Workflow promotion. When enforcement is true, all exact descriptor fields
# are mandatory and publication fails closed without a matching active release.
# Canonical ADK mode always enforces promotion; false is honored only outside canonical mode.
PUBLIC_WIRE_RELEASE_ATTESTATION_ENFORCED=false
PUBLIC_WIRE_WORKFLOW_DIGEST=
PUBLIC_WIRE_BUILD_DIGEST=
PUBLIC_WIRE_EVALUATOR_VERSION=trajectory-v1
PUBLIC_WIRE_EVAL_CORPUS_HASH=

# Reliability tracing and optional result forwarding
DD_SERVICE=public-wire
DD_ENV=development
DD_TRACE_AGENT_URL=
DATADOG_LAPDOG_URL=

# UI rollout flags
PUBLIC_WIRE_UI_CASE_FILES=true
PUBLIC_WIRE_UI_LIVE_EVENTS=false
PUBLIC_WIRE_UI_CLAIM_RECEIPTS=true
PUBLIC_WIRE_UI_BRIEF_PROVENANCE=true
PUBLIC_WIRE_UI_LANDING_SHOWCASE=true
